# Copy to .env and adjust. The real .env is ignored by git. Never commit secrets.

# Sites allowed to call the API from a browser (comma separated).
# Default: the local development server only.
# PIXELINHA_ALLOWED_ORIGINS=https://pixelinha.vercel.app
# Optional pattern for extra sites, such as Vercel preview addresses.
# PIXELINHA_ALLOWED_ORIGIN_REGEX=https://pixelinha-.*\.vercel\.app

# Limits (optional, these are the defaults).
# PIXELINHA_MAX_UPLOAD_BYTES=10485760
# PIXELINHA_MAX_IMAGE_PIXELS=40000000
# PIXELINHA_MIN_GRID_WIDTH=10
# PIXELINHA_MAX_GRID_WIDTH=300
# PIXELINHA_MIN_COLORS=1
# PIXELINHA_MAX_COLORS=40
# PIXELINHA_MAX_STITCHES=90000

# Used from Phase 3 (login and projects). The secret key stays on the server.
# SUPABASE_URL=https://frabklyskmutqxkasflx.supabase.co
# SUPABASE_SECRET_KEY=
