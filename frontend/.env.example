# Copy to .env.local and adjust. Variables that start with VITE_ are public:
# they end up in the browser, so never put secrets here.

# Address of the API. Leave empty in development: Vite forwards /api to
# http://localhost:8000 (change with VITE_DEV_API if the API runs elsewhere).
# In production, set it to the address of the deployed API.
VITE_API_URL=

# Supabase (used from Phase 3, login and projects).
VITE_SUPABASE_URL=https://frabklyskmutqxkasflx.supabase.co
# The publishable key is safe in the browser. Never use the secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
